# ─── Workspace ──────────────────────────────────────────────────
DATABRICKS_HOST=adb-7405616034846735.15.azuredatabricks.net

# ─── Auth ───────────────────────────────────────────────────────
# Run `az login` first — the Databricks SDK picks up your Azure AD
# session automatically. No token or secret needed.
#
# Alternative: Service Principal (for headless / CI environments)
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# ARM_TENANT_ID=

# ─── Genie App ──────────────────────────────────────────────────
# URL of the deployed Genie App (from the genie_space submodule).
# Required — this is what the iframe loads.
GENIE_APP_URL=https://genie-space-embed-7405616034846735.15.azure.databricksapps.com
